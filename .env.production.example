# =============================================================================
# Production .env template for cPanel shared hosting.
# Copy this to ".env" ON THE SERVER (never commit the real .env), then fill in
# the real values and run: php artisan key:generate
# =============================================================================

APP_NAME="Echo of Unity"
APP_ENV=production
APP_KEY=                         # filled by `php artisan key:generate`
APP_DEBUG=false
APP_URL=https://eou.wipxio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Members imported without an email get username@THIS_DOMAIN
MEMBER_EMAIL_DOMAIN=eou.wipxio.com

# Seeded admin account (used by DefaultDataSeeder on FIRST db:seed).
# Set a strong password BEFORE the first seed, then remove these lines.
ADMIN_EMAIL=admin@wipxio.com
ADMIN_NAME="System Administrator"
ADMIN_PASSWORD=CHANGE_ME_STRONG

BCRYPT_ROUNDS=12

# ---- Logging (production) ---------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---- Database (cPanel MySQL — names are prefixed with your cPanel user) ------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=wipxioco_barakah
DB_USERNAME=wipxioco_barakah
DB_PASSWORD=your-db-password

# ---- Sessions / Cache / Queue (DB-backed; no Redis on shared hosting) -------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# database = process emails via the cron worker (recommended)
# sync     = send emails during the request (no cron needed, slower requests)
QUEUE_CONNECTION=database

# ---- Mail (your SMTP provider) ----------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.wipxio.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@wipxio.com
MAIL_PASSWORD=your-mail-password
MAIL_FROM_ADDRESS="no-reply@wipxio.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
